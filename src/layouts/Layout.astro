---
import Navbar from '../components/Navbar.astro';
import MobileCTA from '../components/MobileCTA.astro';
import '../styles/global.css';
import {
  siteName,
  siteUrl,
  seoDefaults,
  whatsappUrl,
  daysmartUrl,
  locationShort,
  contactPhoneRaw,
  footerTagline,
  footerNavLinks,
  socials,
  businessHours,
} from '../data/siteData.js';

interface Props {
  title?: string;
  description?: string;
  /** Optional array of {q, a} to emit FAQPage schema */
  faqSchema?: { q: string; a: string }[];
}

const {
  title = seoDefaults.title,
  description = seoDefaults.description,
  faqSchema,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// LocalBusiness structured data — helps Google Business / local pack + AI search
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["HealthAndBeautyBusiness", "DaySpa"],
  name: siteName,
  description: seoDefaults.description,
  url: siteUrl,
  telephone: contactPhoneRaw,
  priceRange: "GY$2,000 – GY$500,000",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Delph Avenue, between Duncan & William Street, Campbellville",
    addressLocality: "Georgetown",
    addressCountry: "GY",
  },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday","Tuesday","Wednesday","Thursday","Friday"], opens: "10:00", closes: "18:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "09:30", closes: "19:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Sunday", opens: "10:00", closes: "18:00" },
  ],
  sameAs: socials.map(s => s.href),
};

const faqJsonLd = faqSchema && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqSchema.map(f => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0D0A0F" />
    <meta name="google-site-verification" content="0o5L-6WbCYFS8x-BnFLcJKbfodoKAQ_F_9tiPkW946U" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  </head>
  <body class="antialiased" style="background-color:#0D0A0F; color:#F5EFE6;">
    <Navbar />
    <main>
      <slot />
    </main>
    <MobileCTA />

    <!-- Footer -->
    <footer class="border-t pb-24 lg:pb-0" style="border-color:rgba(212,175,55,0.15); background:#0A0710;">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 py-16 grid grid-cols-1 md:grid-cols-3 gap-12">
        <div>
          <p class="text-xs tracking-[0.25em] uppercase mb-1" style="font-family:'Montserrat',sans-serif; color:#D4C9B5;">Crème De La Crème</p>
          <p class="text-2xl font-light gold-text mb-4" style="font-family:'Cormorant Garamond',serif;">Spa &amp; Beauty</p>
          <p class="text-sm leading-relaxed" style="color:#C8B89A; font-family:'Montserrat',sans-serif; font-weight:400;">{footerTagline}</p>
          <!-- Social icons -->
          <div class="flex items-center gap-4 mt-5">
            {socials.map(s => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="transition-opacity duration-200 hover:opacity-100"
                style="color:#D4AF37; opacity:0.65;"
                set:html={s.icon}
              />
            ))}
          </div>
        </div>
        <div>
          <p class="text-xs tracking-[0.2em] uppercase mb-5 gold-text" style="font-family:'Montserrat',sans-serif;">Navigate</p>
          <ul class="space-y-3">
            {footerNavLinks.map(l => (
              <li><a href={l.href} class="nav-link" style="font-size:0.8rem;">{l.label}</a></li>
            ))}
          </ul>
          <p class="text-xs tracking-[0.2em] uppercase mt-8 mb-4 gold-text" style="font-family:'Montserrat',sans-serif;">Hours</p>
          <ul class="space-y-1.5">
            {businessHours.map(h => (
              <li class="text-xs" style="color:#A08878; font-family:'Montserrat',sans-serif;">{h.day}: <span style="color:#C8B89A;">{h.time}</span></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="text-xs tracking-[0.2em] uppercase mb-5 gold-text" style="font-family:'Montserrat',sans-serif;">Book &amp; Connect</p>
          <div class="space-y-4">
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-gold text-xs py-2.5 px-5 inline-flex"
            >Book via WhatsApp</a>
            <br />
            <a
              href={daysmartUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-outline-gold text-xs py-2.5 px-5 inline-flex"
            >Online Calendar</a>
            <br />
            <a href="/beauty-plan" class="nav-link text-xs" style="font-size:0.72rem;">Not sure where to start? Get your free Beauty Plan →</a>
          </div>
          <p class="mt-6 text-xs" style="color:#A08878; font-family:'Montserrat',sans-serif;">{locationShort}</p>
        </div>
      </div>
      <div class="border-t py-6 text-center" style="border-color:rgba(212,175,55,0.08);">
        <p class="text-xs" style="color:#7A6A58; font-family:'Montserrat',sans-serif;">© {new Date().getFullYear()} {siteName}. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
