---
import Layout from '../layouts/Layout.astro';
import BeautyPlanQuiz from '../components/BeautyPlanQuiz.astro';
import {
  whatsappUrl,
  locationAddress,
  businessHours,
  homepageHero,
  homepagePromise,
  painSection,
  resultsPillars,
  serviceOverviews,
  differentiators,
  faqs,
  formatPrice,
} from '../data/siteData.js';

const trustMarkers = [
  "Open 7 Days a Week",
  "Fast WhatsApp Replies",
  "Medical-Grade Technology",
  "Consultation Before Every Treatment",
];
---

<Layout
  title="Med Spa in Georgetown, Guyana | Crème De La Crème Spa & Beauty"
  description="Guyana's premier med spa for clinical facials, body contouring, laser hair removal, Botox, fillers & IV therapy. Book instantly on WhatsApp — we reply fast."
  faqSchema={faqs}
>

  <!-- ===== HERO ===== -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
    style="background: radial-gradient(ellipse at 60% 50%, #2D1035 0%, #1A0A1E 40%, #0D0A0F 100%);"
  >
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full opacity-10" style="background: radial-gradient(circle, #D4AF37, transparent 70%); filter: blur(80px);"></div>
      <div class="absolute bottom-1/3 right-1/4 w-72 h-72 rounded-full opacity-8" style="background: radial-gradient(circle, #6B2FA0, transparent 70%); filter: blur(100px);"></div>
    </div>
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]" style="background-image: linear-gradient(rgba(212,175,55,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(212,175,55,0.5) 1px, transparent 1px); background-size: 80px 80px;"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center pt-32 pb-16">
      <p class="eyebrow gold-text mb-6">{homepageHero.eyebrow}</p>

      <h1 class="font-light leading-[1.08] mb-6" style="font-family:'Cormorant Garamond',serif; font-size:clamp(2.6rem,7vw,5.6rem); color:#F5EFE6;">
        {homepageHero.headlinePt1}<br />
        <em class="gold-text not-italic">{homepageHero.headlineEm}</em><br />
        <span style="font-size:0.62em; color:#D4C9B5;">{homepageHero.headlinePt2}</span>
      </h1>

      <div class="section-divider mb-6"></div>

      <p class="text-base lg:text-lg leading-relaxed max-w-2xl mx-auto mb-10" style="font-family:'Montserrat',sans-serif; font-weight:400; color:#D4C9B5;">
        {homepageHero.subheadline}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gold text-xs px-8 py-4 w-full sm:w-auto justify-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.525 5.845L0 24l6.355-1.507A11.943 11.943 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.792 9.792 0 01-5.003-1.372l-.357-.213-3.773.893.945-3.668-.234-.377A9.789 9.789 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
          </svg>
          {homepageHero.ctaPrimary}
        </a>
        <a href="/beauty-plan" class="btn-outline-gold text-xs px-8 py-4 w-full sm:w-auto justify-center">
          {homepageHero.ctaSecond}
        </a>
      </div>

      <!-- Trust strip -->
      <div class="mt-16 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {trustMarkers.map(t => (
          <div class="flex items-center gap-2">
            <span class="block w-1 h-1 rounded-full" style="background:#D4AF37;"></span>
            <span class="text-xs" style="font-family:'Montserrat',sans-serif; color:#B8A080; letter-spacing:0.12em; text-transform:uppercase; font-size:0.65rem;">{t}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PAIN → AGITATE ===== -->
  <section class="py-28 px-6" style="background:#0A0710;">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="eyebrow gold-text mb-3">{painSection.eyebrow}</p>
        <h2 class="font-light leading-tight max-w-3xl mx-auto" style="font-family:'Cormorant Garamond',serif; font-size:clamp(1.9rem,4.5vw,3.2rem); color:#F5EFE6;">{painSection.heading}</h2>
        <div class="section-divider mt-4"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {painSection.pains.map((p) => (
          <div class="luxury-card rounded-sm p-8">
            <div class="w-8 h-px mb-5" style="background:#D4AF37;"></div>
            <h3 class="font-light mb-3" style="font-family:'Cormorant Garamond',serif; font-size:1.35rem; color:#F5EFE6;">{p.title}</h3>
            <p class="body-copy">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== TRANSFORMATION PILLARS ===== -->
  <section class="py-28 px-6" style="background: linear-gradient(180deg, #0A0710 0%, #110814 100%);">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="eyebrow gold-text mb-3">What You Actually Get</p>
        <h2 class="font-light leading-tight" style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,5vw,3.5rem); color:#F5EFE6;">Three Transformations.<br /><span style="font-size:0.65em; color:#B8A080; font-style:italic;">one address in Campbellville.</span></h2>
        <div class="section-divider mt-4"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        {resultsPillars.map((r) => (
          <div class="text-center px-2">
            <p class="gold-text font-light mb-4" style="font-family:'Cormorant Garamond',serif; font-size:3rem; line-height:1;">{r.stat}</p>
            <h3 class="font-light mb-4" style="font-family:'Cormorant Garamond',serif; font-size:1.45rem; color:#F5EFE6;">{r.title}</h3>
            <p class="body-copy">{r.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== SERVICES OVERVIEW ===== -->
  <section class="py-28 px-6" style="background:#0D0A0F;">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="eyebrow gold-text mb-3">Our Services</p>
        <h2 class="font-light leading-tight" style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,5vw,3.5rem); color:#F5EFE6;">Pick the Result.<br /><span style="font-size:0.65em; color:#B8A080; font-style:italic;">we'll handle the how.</span></h2>
        <div class="section-divider mt-4"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {serviceOverviews.map((s) => (
          <a href={s.href} class="luxury-card rounded-sm p-8 flex flex-col no-underline group">
            <p class="text-xs mb-2 gold-text" style="font-family:'Montserrat',sans-serif; letter-spacing:0.18em; text-transform:uppercase; font-size:0.62rem;">{s.benefit}</p>
            <h3 class="font-light mb-3 leading-snug" style="font-family:'Cormorant Garamond',serif; font-size:1.4rem; color:#F5EFE6;">{s.title}</h3>
            <p class="body-copy flex-1 mb-6">{s.description}</p>
            <div class="flex items-center justify-between">
              <span class="text-xs" style="font-family:'Montserrat',sans-serif; color:#B8A080; font-size:0.72rem;">From <span class="gold-text font-semibold">{formatPrice(s.priceFrom)}</span></span>
              <span class="nav-link text-xs flex items-center gap-2" style="font-size:0.68rem;">
                View Menu
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-12">
        <a href="/services" class="btn-outline-gold text-xs px-10 py-3.5">See All Services & Prices</a>
      </div>
    </div>
  </section>

  <!-- ===== DIFFERENTIATORS ===== -->
  <section class="py-28 px-6" style="background: radial-gradient(ellipse at 30% 50%, #1A0A1E 0%, #0A0710 70%);">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="eyebrow gold-text mb-3">Why Clients Never Go Back Elsewhere</p>
        <h2 class="font-light leading-tight" style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,5vw,3.5rem); color:#F5EFE6;">The Crème De La Crème Standard</h2>
        <div class="section-divider mt-4"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {differentiators.map((d, i) => (
          <div class="luxury-card rounded-sm p-8">
            <p class="gold-text font-light mb-4" style="font-family:'Cormorant Garamond',serif; font-size:2rem; line-height:1;">0{i + 1}</p>
            <h3 class="font-light mb-3" style="font-family:'Cormorant Garamond',serif; font-size:1.2rem; color:#F5EFE6;">{d.title}</h3>
            <p class="body-copy" style="font-size:0.82rem;">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== LEAD-CAPTURE QUIZ ===== -->
  <BeautyPlanQuiz />

  <!-- ===== FAQ ===== -->
  <section class="py-28 px-6" style="background:#0A0710;">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-14">
        <p class="eyebrow gold-text mb-3">Good Questions</p>
        <h2 class="font-light leading-tight" style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,5vw,3.2rem); color:#F5EFE6;">Everything You're Wondering</h2>
        <div class="section-divider mt-4"></div>
      </div>
      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="luxury-card rounded-sm group">
            <summary class="cursor-pointer list-none p-6 flex items-center justify-between gap-4">
              <span class="font-light" style="font-family:'Cormorant Garamond',serif; font-size:1.15rem; color:#F5EFE6;">{f.q}</span>
              <span class="gold-text shrink-0 transition-transform duration-300 group-open:rotate-45" style="font-size:1.3rem; line-height:1;">+</span>
            </summary>
            <p class="body-copy px-6 pb-6">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== LOCATION & HOURS ===== -->
  <section class="py-28 px-6" style="background:#0D0A0F;">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="eyebrow gold-text mb-3">Find Us</p>
        <h2 class="font-light leading-tight" style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,5vw,3.5rem); color:#F5EFE6;">Location &amp; Hours</h2>
        <div class="section-divider mt-4"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div class="luxury-card rounded-sm p-10">
          <p class="text-xs tracking-[0.2em] uppercase mb-8 gold-text" style="font-family:'Montserrat',sans-serif;">Opening Hours</p>
          <ul class="space-y-5">
            {businessHours.map((h) => (
              <li class="flex justify-between items-center border-b pb-5" style="border-color:rgba(212,175,55,0.1);">
                <span class="text-sm" style="font-family:'Montserrat',sans-serif; font-weight:400; color:#D4C9B5;">{h.day}</span>
                <span class="text-sm font-medium gold-text" style="font-family:'Montserrat',sans-serif;">{h.time}</span>
              </li>
            ))}
          </ul>

          <div class="mt-10 pt-6 border-t" style="border-color:rgba(212,175,55,0.1);">
            <p class="text-xs tracking-[0.2em] uppercase mb-4 gold-text" style="font-family:'Montserrat',sans-serif;">Address</p>
            <p class="text-sm leading-relaxed" style="font-family:'Montserrat',sans-serif; font-weight:400; color:#D4C9B5;">
              {locationAddress}
            </p>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-gold text-xs mt-6 inline-flex px-7 py-3"
            >
              Book Your Visit
            </a>
          </div>
        </div>

        <div class="luxury-card rounded-sm overflow-hidden" style="min-height:420px;">
          <iframe
            title="Crème De La Crème Spa & Beauty Location"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3916.9!2d-58.161!3d6.808!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8d5995c67a0b!2sDelph+Ave%2C+Georgetown%2C+Guyana!5e0!3m2!1sen!2sgy!4v1"
            width="100%"
            height="420"
            style="border:0; filter: saturate(0.65) brightness(0.85) sepia(0.2);"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PROMISE BANNER ===== -->
  <section class="py-24 px-6 text-center" style="background: radial-gradient(ellipse at center, #2D1035 0%, #0D0A0F 70%);">
    <div class="max-w-2xl mx-auto">
      <div class="section-divider mb-8"></div>
      <h2 class="font-light italic mb-4" style="font-family:'Cormorant Garamond',serif; font-size:clamp(1.8rem,4vw,3rem); color:#F5EFE6;">
        "{homepagePromise.quote}"
      </h2>
      <p class="text-sm mb-10" style="font-family:'Montserrat',sans-serif; font-weight:400; color:#C4A882; line-height:1.8;">{homepagePromise.body}</p>
      <div class="section-divider mb-10"></div>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-gold text-xs px-10 py-4"
      >{homepagePromise.cta}</a>
    </div>
  </section>

</Layout>
