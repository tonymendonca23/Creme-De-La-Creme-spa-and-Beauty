---
import Layout from '../layouts/Layout.astro';
import {
  whatsappUrl,
  daysmartUrl,
  locationAddress,
  businessHours,
  homepageHero,
  homepagePromise,
  serviceOverviews,
} from '../data/siteData.js';
---

<Layout title="Crème De La Crème Spa & Beauty | Georgetown, Guyana">

  <!-- ===== HERO ===== -->
  <section
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
    style="background: radial-gradient(ellipse at 60% 50%, #2D1035 0%, #1A0A1E 40%, #0D0A0F 100%);"
  >

    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full opacity-10" style="background: radial-gradient(circle, #D4AF37, transparent 70%); filter: blur(80px);"></div>
      <div class="absolute bottom-1/3 right-1/4 w-72 h-72 rounded-full opacity-8" style="background: radial-gradient(circle, #6B2FA0, transparent 70%); filter: blur(100px);"></div>
    </div>

    
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]" style="background-image: linear-gradient(rgba(212,175,55,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(212,175,55,0.5) 1px, transparent 1px); background-size: 80px 80px;"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center pt-32 pb-20">
      
      <p class="text-xs tracking-[0.35em] uppercase mb-6 gold-text" style="font-family:'Montserrat',sans-serif;">{homepageHero.eyebrow}</p>

      
      <h1 class="font-light leading-[1.1] mb-6" style="font-family:'Cormorant Garamond',serif; font-size:clamp(3rem,8vw,6.5rem); color:#F5EFE6;">
        {homepageHero.headlinePt1}<br />
        <em class="gold-text not-italic">{homepageHero.headlineEm}</em><br />
        {homepageHero.headlinePt2}
      </h1>

    
      <div class="section-divider mb-6"></div>

    
      <p class="text-base lg:text-lg leading-relaxed max-w-xl mx-auto mb-10" style="font-family:'Montserrat',sans-serif; font-weight:400; color:#D4C9B5;">
        {homepageHero.subheadline}
      </p>

      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gold text-xs px-8 py-4 w-full sm:w-auto justify-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.525 5.845L0 24l6.355-1.507A11.943 11.943 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.792 9.792 0 01-5.003-1.372l-.357-.213-3.773.893.945-3.668-.234-.377A9.789 9.789 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
          </svg>
          {homepageHero.ctaPrimary}
        </a>
        <a
          href={daysmartUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline-gold text-xs px-8 py-4 w-full sm:w-auto justify-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 shrink-0" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
          </svg>
          {homepageHero.ctaSecond}
        </a>
      </div>

      
      <div class="mt-20 flex flex-col items-center gap-2 opacity-40">
        <span class="text-xs tracking-[0.2em] uppercase" style="font-family:'Montserrat',sans-serif; color:#BBA88A; font-size:0.65rem;">Discover</span>
        <div class="w-px h-12 gold-gradient"></div>
      </div>
    </div>
  </section>

  
  <section class="py-28 px-6" style="background: linear-gradient(180deg, #0D0A0F 0%, #110814 100%);">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-16">
        <p class="text-xs tracking-[0.3em] uppercase mb-3 gold-text" style="font-family:'Montserrat',sans-serif;">Crafted for You</p>
        <h2 class="font-light leading-tight" style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,5vw,3.5rem); color:#F5EFE6;">A Full World of Beauty<br /><span style="font-size:0.65em; color:#B8A080; font-style:italic;">under one roof in Georgetown</span></h2>
        <div class="section-divider mt-4"></div>
      </div>

      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {serviceOverviews.map((s) => (
          <div class="luxury-card rounded-sm p-8 flex flex-col">
            
            <div class="mb-5 gold-text" set:html={s.icon} />
    
            <h3 class="font-light mb-3 leading-snug" style="font-family:'Cormorant Garamond',serif; font-size:1.3rem; color:#F5EFE6;">{s.title}</h3>
            
            <p class="text-sm flex-1 mb-6" style="font-family:'Montserrat',sans-serif; font-weight:400; color:#C4A882; font-size:0.875rem; line-height:1.8;">{s.description}</p>
            
            <a href={s.href} class="nav-link text-xs self-start flex items-center gap-2" style="font-size:0.7rem;">
              View Details
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
              </svg>
            </a>
          </div>
        ))}
      </div>

      <!-- View All Services CTA -->
      <div class="text-center mt-12">
        <a href="/services" class="btn-outline-gold text-xs px-10 py-3.5">Explore All Services</a>
      </div>
    </div>
  </section>

  <!-- ===== LOCATION & HOURS ===== -->
  <section class="py-28 px-6" style="background: #0A0710;">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-xs tracking-[0.3em] uppercase mb-3 gold-text" style="font-family:'Montserrat',sans-serif;">Find Us</p>
        <h2 class="font-light leading-tight" style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,5vw,3.5rem); color:#F5EFE6;">Location &amp; Hours</h2>
        <div class="section-divider mt-4"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">

        <!-- Hours Card — loops over businessHours from siteData.js -->
        <div class="luxury-card rounded-sm p-10">
          <p class="text-xs tracking-[0.2em] uppercase mb-8 gold-text" style="font-family:'Montserrat',sans-serif;">Opening Hours</p>
          <ul class="space-y-5">
            {businessHours.map((h) => (
              <li class="flex justify-between items-center border-b pb-5" style="border-color:rgba(212,175,55,0.1);">
                <span class="text-sm" style="font-family:'Montserrat',sans-serif; font-weight:400; color:#D4C9B5;">{h.day}</span>
                <span class="text-sm font-medium gold-text" style="font-family:'Montserrat',sans-serif;">{h.time}</span>
              </li>
            ))}
          </ul>

          <div class="mt-10 pt-6 border-t" style="border-color:rgba(212,175,55,0.1);">
            <p class="text-xs tracking-[0.2em] uppercase mb-4 gold-text" style="font-family:'Montserrat',sans-serif;">Address</p>
            <p class="text-sm leading-relaxed" style="font-family:'Montserrat',sans-serif; font-weight:400; color:#D4C9B5;">
              {locationAddress}
            </p>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-gold text-xs mt-6 inline-flex px-7 py-3"
            >
              Book Your Visit
            </a>
          </div>
        </div>

        <!-- Map Card -->
        <div class="luxury-card rounded-sm overflow-hidden" style="min-height:420px;">
          <iframe
            title="Crème De La Crème Spa & Beauty Location"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3916.9!2d-58.161!3d6.808!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8d5995c67a0b!2sDelph+Ave%2C+Georgetown%2C+Guyana!5e0!3m2!1sen!2sgy!4v1"
            width="100%"
            height="420"
            style="border:0; filter: saturate(0.65) brightness(0.85) sepia(0.2);"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

      </div>
    </div>
  </section>

  <!-- ===== LUXURY PROMISE BANNER ===== -->
  <section class="py-24 px-6 text-center" style="background: radial-gradient(ellipse at center, #2D1035 0%, #0D0A0F 70%);">
    <div class="max-w-2xl mx-auto">
      <div class="section-divider mb-8"></div>
      <h2 class="font-light italic mb-4" style="font-family:'Cormorant Garamond',serif; font-size:clamp(1.8rem,4vw,3rem); color:#F5EFE6;">
        "{homepagePromise.quote}"
      </h2>
      <p class="text-sm mb-10" style="font-family:'Montserrat',sans-serif; font-weight:400; color:#C4A882; line-height:1.8;">{homepagePromise.body}</p>
      <div class="section-divider mb-10"></div>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-gold text-xs px-10 py-4"
      >{homepagePromise.cta}</a>
    </div>
  </section>

</Layout>
