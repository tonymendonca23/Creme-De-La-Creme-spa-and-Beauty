---
import Layout from '../layouts/Layout.astro';
import { whatsappNumber } from '../data/siteData.js';
import { serviceCategories, formatPrice, daySmartUrl } from '../data/services';

// Per-service WhatsApp ask link (secondary channel for questions)
function askLink(serviceName: string) {
  const msg = `Hi Crème De La Crème! I have a question about: ${serviceName}.`;
  return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`;
}
---

<Layout
  title="Spa Services & Prices — Georgetown, Guyana | Crème De La Crème"
  description="Full price list: facials from GY$10,000, laser hair removal from GY$6,000, body contouring, Botox, fillers & IV therapy in Georgetown. Book online today."
>

  <!-- Hero -->
  <section
    class="relative pt-40 pb-16 px-6 text-center"
    style="background: radial-gradient(ellipse at 60% 0%, #2D1035 0%, #0D0A0F 70%);"
  >
    <div class="absolute inset-0 pointer-events-none opacity-[0.025]" style="background-image: linear-gradient(rgba(212,175,55,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(212,175,55,0.5) 1px, transparent 1px); background-size: 80px 80px;"></div>
    <div class="relative z-10 max-w-2xl mx-auto">
      <p class="eyebrow gold-text mb-4">Transparent Pricing. No Surprises.</p>
      <h1 class="font-light leading-tight mb-4" style="font-family:'Cormorant Garamond',serif; font-size:clamp(2.5rem,6vw,5rem); color:#F5EFE6;">Services &amp; Prices</h1>
      <div class="section-divider mb-6"></div>
      <p class="text-sm leading-relaxed" style="font-family:'Montserrat',sans-serif; font-weight:400; color:#D4C9B5;">
        Every treatment below is delivered after a proper consultation, explained step-by-step,<br class="hidden sm:block" /> and priced openly — because you should know exactly what you're investing in.
      </p>
    </div>
  </section>

  <!-- Sticky category anchor nav -->
  <nav class="sticky top-20 z-40 py-4 px-6 border-y" style="background: rgba(13,10,15,0.95); backdrop-filter: blur(20px); border-color:rgba(212,175,55,0.12);" aria-label="Service categories">
    <div class="max-w-7xl mx-auto flex gap-6 overflow-x-auto whitespace-nowrap" style="scrollbar-width:none;">
      {serviceCategories.map((cat) => (
        <a href={`#${cat.id}`} class="nav-link" style="font-size:0.66rem;">{cat.label}</a>
      ))}
    </div>
  </nav>

  <!-- Categories -->
  {serviceCategories.map((cat, i) => (
    <section
      id={cat.id}
      class="py-20 px-6"
      style={`background: ${i % 2 === 0 ? '#0D0A0F' : '#0A0710'}; scroll-margin-top: 130px;`}
    >
      <div class="max-w-7xl mx-auto">
        <!-- Category Header -->
        <div class="mb-12 max-w-3xl">
          <p class="text-xs tracking-[0.25em] uppercase mb-2 gold-text" style="font-family:'Montserrat',sans-serif;">0{i + 1}</p>
          <h2 class="font-light leading-tight" style="font-family:'Cormorant Garamond',serif; font-size:clamp(1.8rem,4vw,3rem); color:#F5EFE6;">{cat.label}</h2>
          <p class="text-base mt-2 italic gold-text" style="font-family:'Cormorant Garamond',serif;">{cat.tagline}</p>
          <p class="body-copy mt-3">{cat.intro}</p>
        </div>

        <!-- Service cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {cat.services.map((svc) => (
            <article class="luxury-card rounded-sm p-7 flex flex-col" id={svc.id}>
              <div class="flex justify-between items-start gap-3 mb-3">
                <h3 class="font-light leading-snug" style="font-family:'Cormorant Garamond',serif; font-size:1.2rem; color:#F5EFE6;">{svc.name}</h3>
                <span class="text-xs shrink-0 px-2.5 py-1.5 rounded-sm font-semibold" style="font-family:'Montserrat',sans-serif; background:rgba(212,175,55,0.12); color:#E8CC6A; border:1px solid rgba(212,175,55,0.3); white-space:nowrap;">{formatPrice(svc.price)}</span>
              </div>
              <p class="body-copy flex-1 mb-6" style="font-size:0.83rem;">{svc.description}</p>
              <div class="flex flex-col sm:flex-row gap-3">
                <a
                  href={svc.daySmartUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-gold text-xs px-5 py-3 flex-1 justify-center"
                  style="min-height:2.75rem; padding-top:0.7rem; padding-bottom:0.7rem;"
                >Book Appointment</a>
                {svc.hasDetailPage && svc.detail && (
                  <button
                    type="button"
                    class="btn-outline-gold text-xs px-5 py-3 flex-1 justify-center view-details-btn"
                    style="min-height:2.75rem; padding-top:0.7rem; padding-bottom:0.7rem;"
                    data-detail={JSON.stringify({
                      name: svc.name,
                      price: formatPrice(svc.price),
                      description: svc.description,
                      benefits: svc.detail.benefits,
                      sessions: svc.detail.sessions,
                      downtime: svc.detail.downtime,
                      book: svc.daySmartUrl,
                      ask: askLink(svc.name),
                    })}
                  >View Details</button>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Bottom CTA -->
  <section class="py-24 px-6 text-center" style="background: radial-gradient(ellipse at center, #1A0A1E 0%, #0D0A0F 70%);">
    <div class="max-w-xl mx-auto">
      <div class="section-divider mb-8"></div>
      <h2 class="font-light mb-4" style="font-family:'Cormorant Garamond',serif; font-size:clamp(1.8rem,4vw,2.8rem); color:#F5EFE6;">Not sure which treatment is right for you?</h2>
      <p class="text-sm mb-10" style="font-family:'Montserrat',sans-serif; font-weight:400; color:#C4A882;">Take the 30-second Beauty Plan quiz and a specialist will recommend the exact treatment for your goal — free, on WhatsApp.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/beauty-plan" class="btn-gold text-xs px-9 py-4 w-full sm:w-auto justify-center">Get My Free Beauty Plan</a>
        <a
          href={daySmartUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline-gold text-xs px-9 py-4 w-full sm:w-auto justify-center"
        >Online Calendar</a>
      </div>
      <div class="section-divider mt-10"></div>
    </div>
  </section>

  <!-- ===== View Details Modal ===== -->
  <div
    id="service-modal"
    class="fixed inset-0 z-[60] hidden items-center justify-center px-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <div id="modal-backdrop" class="absolute inset-0" style="background: rgba(5,3,7,0.82); backdrop-filter: blur(6px);"></div>

    <div class="relative luxury-card rounded-sm w-full max-w-lg max-h-[85vh] overflow-y-auto p-8 sm:p-10" style="background: #140A19; border-color: rgba(212,175,55,0.4);">
      <button
        type="button"
        id="modal-close"
        class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center cursor-pointer rounded-sm"
        style="color:#E8CC6A; border:1px solid rgba(212,175,55,0.3); background:rgba(212,175,55,0.06);"
        aria-label="Close details"
      >✕</button>

      <p class="eyebrow gold-text mb-2" style="font-size:0.6rem;">Treatment Details</p>
      <h3 id="modal-title" class="font-light leading-snug mb-1" style="font-family:'Cormorant Garamond',serif; font-size:1.7rem; color:#F5EFE6;"></h3>
      <p id="modal-price" class="text-sm font-semibold gold-text mb-5" style="font-family:'Montserrat',sans-serif;"></p>

      <p id="modal-desc" class="body-copy mb-6"></p>

      <p class="text-xs tracking-[0.2em] uppercase mb-3 gold-text" style="font-family:'Montserrat',sans-serif;">What You Get</p>
      <ul id="modal-benefits" class="space-y-2.5 mb-6"></ul>

      <div id="modal-meta" class="space-y-2 mb-8"></div>

      <div class="flex flex-col sm:flex-row gap-3">
        <a id="modal-book" href="#" target="_blank" rel="noopener noreferrer" class="btn-gold text-xs px-6 py-3.5 flex-1 justify-center">Book Appointment</a>
        <a id="modal-ask" href="#" target="_blank" rel="noopener noreferrer" class="btn-outline-gold text-xs px-6 py-3.5 flex-1 justify-center">Ask on WhatsApp</a>
      </div>
    </div>
  </div>

</Layout>

<script>
  const modal     = document.getElementById('service-modal')!;
  const backdrop  = document.getElementById('modal-backdrop')!;
  const closeBtn  = document.getElementById('modal-close')!;
  const titleEl   = document.getElementById('modal-title')!;
  const priceEl   = document.getElementById('modal-price')!;
  const descEl    = document.getElementById('modal-desc')!;
  const benefitsEl = document.getElementById('modal-benefits')!;
  const metaEl    = document.getElementById('modal-meta')!;
  const bookEl    = document.getElementById('modal-book') as HTMLAnchorElement;
  const askEl     = document.getElementById('modal-ask') as HTMLAnchorElement;

  let lastFocused: HTMLElement | null = null;

  function openModal(detail: any) {
    titleEl.textContent = detail.name;
    priceEl.textContent = detail.price;
    descEl.textContent  = detail.description;

    benefitsEl.innerHTML = '';
    (detail.benefits || []).forEach((b: string) => {
      const li = document.createElement('li');
      li.className = 'flex items-start gap-3';
      li.innerHTML = `<span class="mt-2 block w-1.5 h-1.5 shrink-0 rounded-full" style="background:#D4AF37;"></span><span class="body-copy" style="font-size:0.83rem;">${b}</span>`;
      benefitsEl.appendChild(li);
    });

    metaEl.innerHTML = '';
    const metaRow = (label: string, value?: string) => {
      if (!value) return;
      const p = document.createElement('p');
      p.className = 'text-xs';
      p.style.cssText = "font-family:'Montserrat',sans-serif; color:#B8A080;";
      p.innerHTML = `<span class="gold-text font-semibold" style="letter-spacing:0.12em; text-transform:uppercase; font-size:0.62rem;">${label}:</span> ${value}`;
      metaEl.appendChild(p);
    };
    metaRow('Sessions', detail.sessions);
    metaRow('Downtime', detail.downtime);

    bookEl.href = detail.book;
    askEl.href  = detail.ask;

    lastFocused = document.activeElement as HTMLElement;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    (closeBtn as HTMLElement).focus();
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  document.querySelectorAll<HTMLElement>('.view-details-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      try {
        openModal(JSON.parse(btn.dataset.detail!));
      } catch { /* malformed data — ignore */ }
    });
  });

  backdrop.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
  });
</script>
