---
import Layout from '../layouts/Layout.astro';
import { whatsappUrl, aboutStory, aboutValues } from '../data/siteData.js';
---

<Layout
  title="About | Crème De La Crème Spa & Beauty"
  description="Learn the story behind Georgetown's most luxurious spa & beauty destination."
>

  <!-- Hero -->
  <section
    class="relative pt-40 pb-24 px-6 text-center"
    style="background: radial-gradient(ellipse at 40% 0%, #2D1035 0%, #0D0A0F 70%);"
  >
    <div class="absolute inset-0 pointer-events-none opacity-[0.025]" style="background-image: linear-gradient(rgba(212,175,55,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(212,175,55,0.5) 1px, transparent 1px); background-size: 80px 80px;"></div>
    <div class="relative z-10 max-w-2xl mx-auto">
      <p class="text-xs tracking-[0.35em] uppercase mb-4 gold-text" style="font-family:'Montserrat',sans-serif;">Our Story</p>
      <h1 class="font-light leading-tight mb-4" style="font-family:'Cormorant Garamond',serif; font-size:clamp(2.5rem,6vw,5rem); color:#F5EFE6;">About Us</h1>
      <div class="section-divider mb-6"></div>
    </div>
  </section>

  <!-- Story Section -->
  <section class="py-24 px-6" style="background:#0D0A0F;">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-xs tracking-[0.25em] uppercase mb-4 gold-text" style="font-family:'Montserrat',sans-serif;">{aboutStory.eyebrow}</p>
        <h2 class="font-light leading-tight mb-6" style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,4vw,3rem); color:#F5EFE6;">{aboutStory.heading}</h2>
        <div class="space-y-5 text-sm" style="font-family:'Montserrat',sans-serif; font-weight:400; color:#C4A882; line-height:1.85;">
          {aboutStory.paragraphs.map((para) => (
            <p>{para}</p>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {aboutValues.map((v) => (
          <div class="luxury-card rounded-sm p-7">
            <div class="w-8 h-px mb-4" style="background:#D4AF37;"></div>
            <h3 class="font-light mb-2" style="font-family:'Cormorant Garamond',serif; font-size:1.1rem; color:#F5EFE6;">{v.title}</h3>
            <p class="leading-relaxed" style="font-family:'Montserrat',sans-serif; color:#C4A882; font-weight:400; font-size:0.825rem; line-height:1.75;">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6 text-center" style="background:#0A0710;">
    <div class="max-w-xl mx-auto">
      <h2 class="font-light italic mb-6" style="font-family:'Cormorant Garamond',serif; font-size:clamp(1.8rem,4vw,2.8rem); color:#F5EFE6;">"Come once. You'll understand."</h2>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-gold text-xs px-10 py-4"
      >Book Your Experience</a>
    </div>
  </section>

</Layout>
